diff --git a/conversion/xglm.py b/conversion/xglm.py
new file mode 100644
index 0000000..d04269d
--- /dev/null
+++ b/conversion/xglm.py
@@ -0,0 +1,139 @@
+from __future__ import annotations
+
+import base64
+import json
+import math
+
+from typing import Iterable, TYPE_CHECKING
+
+import torch
+
+if TYPE_CHECKING:
+    from torch import Tensor
+
+from .base import ModelBase, TextModel, gguf
+
+
+@ModelBase.register("XGLMForCausalLM")
+@ModelBase.example("facebook/xglm-564M")
+class XGLMModel(TextModel):
+    model_arch = gguf.MODEL_ARCH.XGLM
+
+    _qkv_parts: list[dict[str, Tensor]] | None = None
+
+    def set_vocab(self):
+        tokenizer_json = json.loads((self.dir_model / "tokenizer.json").read_text(encoding="utf-8"))
+        vocab = tokenizer_json["model"]["vocab"]
+        unk_id = tokenizer_json["model"].get("unk_id", 3)
+        added_ids = {token["id"] for token in tokenizer_json.get("added_tokens", [])}
+
+        tokens = [piece.encode("utf-8") for piece, _ in vocab]
+        scores = [float(score) for _, score in vocab]
+        token_types = [
+            gguf.TokenType.CONTROL if token_id in added_ids else
+            gguf.TokenType.UNKNOWN if token_id == unk_id else
+            gguf.TokenType.NORMAL
+            for token_id in range(len(vocab))
+        ]
+
+        normalizers = tokenizer_json.get("normalizer", {}).get("normalizers", [])
+        precompiled_charsmap = next(
+            normalizer["precompiled_charsmap"]
+            for normalizer in normalizers
+            if normalizer["type"] == "Precompiled"
+        )
+        pretokenizer = tokenizer_json["pre_tokenizer"]
+
+        self.gguf_writer.add_tokenizer_model("t5")
+        self.gguf_writer.add_tokenizer_pre("default")
+        self.gguf_writer.add_token_list(tokens)
+        self.gguf_writer.add_token_scores(scores)
+        self.gguf_writer.add_token_types(token_types)
+        self.gguf_writer.add_add_space_prefix(bool(pretokenizer["add_prefix_space"]))
+        self.gguf_writer.add_remove_extra_whitespaces(
+            any(
+                normalizer["type"] == "Replace" and normalizer.get("pattern", {}).get("Regex") == " {2,}"
+                for normalizer in normalizers
+            )
+        )
+        self.gguf_writer.add_precompiled_charsmap(base64.b64decode(precompiled_charsmap))
+        self.gguf_writer.add_add_bos_token(True)
+        self.gguf_writer.add_add_eos_token(False)
+        self.gguf_writer.add_bos_token_id(2)
+        self.gguf_writer.add_eos_token_id(2)
+        self.gguf_writer.add_unk_token_id(unk_id)
+        self.gguf_writer.add_sep_token_id(2)
+        self.gguf_writer.add_pad_token_id(1)
+        self.gguf_writer.add_token_type_count(1)
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        self.gguf_writer.add_embedding_length(self.hparams["d_model"])
+        self.gguf_writer.add_feed_forward_length(self.hparams["ffn_dim"])
+        self.gguf_writer.add_head_count(self.hparams["attention_heads"])
+        self.gguf_writer.add_head_count_kv(self.hparams["attention_heads"])
+        self.gguf_writer.add_layer_norm_eps(self.hparams.get("layer_norm_epsilon", 1e-5))
+        self.gguf_writer.add_embedding_scale(math.sqrt(self.hparams["d_model"]))
+        self.gguf_writer.add_rope_scaling_type(gguf.RopeScalingType.NONE)
+
+    def generate_extra_tensors(self):
+        n_ctx = self.hparams["max_position_embeddings"]
+        embedding_dim = self.hparams["d_model"]
+        half_dim = embedding_dim // 2
+        frequency = math.log(10000) / (half_dim - 1)
+        positions = torch.arange(2, n_ctx + 2, dtype=torch.float32)
+        frequencies = torch.exp(torch.arange(half_dim, dtype=torch.float32) * -frequency)
+        angles = positions.unsqueeze(1) * frequencies.unsqueeze(0)
+        position_embeddings = torch.cat([torch.sin(angles), torch.cos(angles)], dim=1)
+        yield (
+            self.format_tensor_name(gguf.MODEL_TENSOR.POS_EMBD),
+            position_embeddings,
+        )
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        if name.endswith("model.embed_positions.weights") or (
+            name == "lm_head.weight" and self.hparams.get("tie_word_embeddings", False)
+        ):
+            return
+
+        if ".self_attn.q_proj." in name or ".self_attn.k_proj." in name or ".self_attn.v_proj." in name:
+            suffix = "weight" if name.endswith(".weight") else "bias"
+            part = "q" if ".q_proj." in name else "k" if ".k_proj." in name else "v"
+            key = f"{part}.{suffix}"
+
+            assert bid is not None
+            if self._qkv_parts is None:
+                self._qkv_parts = [{} for _ in range(self.block_count)]
+            self._qkv_parts[bid][key] = data_torch
+
+            q_key, k_key, v_key = f"q.{suffix}", f"k.{suffix}", f"v.{suffix}"
+            if all(key in self._qkv_parts[bid] for key in (q_key, k_key, v_key)):
+                q = self._qkv_parts[bid].pop(q_key)
+                k = self._qkv_parts[bid].pop(k_key)
+                v = self._qkv_parts[bid].pop(v_key)
+                data_torch = torch.cat([q, k, v], dim=0)
+                name = self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_QKV, bid, f".{suffix}")
+            else:
+                return
+
+        if ".self_attn_layer_norm." in name:
+            name = name.replace(".self_attn_layer_norm", ".input_layernorm")
+        elif ".final_layer_norm." in name:
+            name = name.replace(".final_layer_norm", ".post_attention_layernorm")
+        elif name == "model.layer_norm.weight":
+            name = "model.norm.weight"
+        elif name == "model.layer_norm.bias":
+            name = "model.norm.bias"
+        elif ".fc1." in name:
+            name = name.replace(".fc1", ".mlp.up_proj")
+        elif ".fc2." in name:
+            name = name.replace(".fc2", ".mlp.down_proj")
+
+        yield from super().modify_tensors(data_torch, name, bid)
+
+    def prepare_tensors(self):
+        super().prepare_tensors()
+        if self._qkv_parts is not None:
+            parts = [(block, part) for block, tensors in enumerate(self._qkv_parts) for part in tensors]
+            if parts:
+                raise ValueError(f"Unprocessed Q/K/V parts: {parts}")
diff --git a/src/models/xglm.cpp b/src/models/xglm.cpp
new file mode 100644
index 0000000..a377acd
--- /dev/null
+++ b/src/models/xglm.cpp
@@ -0,0 +1,16 @@
+#include "models.h"
+
+void llama_model_xglm::load_arch_hparams(llama_model_loader & ml) {
+    ml.get_key(LLM_KV_ATTENTION_LAYERNORM_EPS, hparams.f_norm_eps);
+    ml.get_key(LLM_KV_EMBEDDING_SCALE, hparams.f_embedding_scale, false);
+
+    if (hparams.n_layer_all == 24 && hparams.n_embd == 1024) {
+        type = LLM_TYPE_0_5B;
+    } else if (hparams.n_layer_all == 24 && hparams.n_embd == 2048) {
+        type = LLM_TYPE_1_7B;
+    } else if (hparams.n_layer_all == 48 && hparams.n_embd == 2048) {
+        type = LLM_TYPE_2_9B;
+    } else {
+        type = LLM_TYPE_UNKNOWN;
+    }
+}
diff --git a/tests/test-xglm-conversion.py b/tests/test-xglm-conversion.py
new file mode 100644
index 0000000..19ce71b
--- /dev/null
+++ b/tests/test-xglm-conversion.py
@@ -0,0 +1,33 @@
+import math
+import sys
+import unittest
+
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from conversion.xglm import XGLMModel
+
+
+class TestXGLMConversion(unittest.TestCase):
+    def test_position_embeddings(self):
+        model = XGLMModel.__new__(XGLMModel)
+        model.hparams = {"d_model": 1024, "max_position_embeddings": 2048}
+        name, positions = next(model.generate_extra_tensors())
+
+        self.assertEqual(name, "position_embd.weight")
+        self.assertEqual(positions.dtype, torch.float32)
+        self.assertEqual(tuple(positions.shape), (2048, 1024))
+
+        half_dim = 1024 // 2
+        for row, position in ((0, 2), (1, 3), (2047, 2049)):
+            frequency = math.log(10000) / (half_dim - 1)
+            angles = position * torch.exp(torch.arange(half_dim, dtype=torch.float32) * -frequency)
+            expected = torch.cat([torch.sin(angles), torch.cos(angles)])
+            torch.testing.assert_close(positions[row], expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
